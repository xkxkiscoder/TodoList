<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TodoList.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TodoList.ViewModels"
    Title="TodoList">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        Padding="14"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ═══ 卡片 1：顶部工具栏 ═══  -->
        <Border
            x:Name="ToolbarHost"
            Grid.Row="0"
            Padding="12,10"
            Style="{StaticResource GlassCardStyle}">
            <Grid>
                <Grid
                    x:Name="TitleBarDrag"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent" />
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        x:Name="BrandPanel"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Border
                            Width="26"
                            Height="26"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="8">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="T" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="TodoList" />
                    </StackPanel>
                    <StackPanel
                        x:Name="SegsPanel"
                        Grid.Column="1"
                        Padding="3"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#2E000000"
                        CornerRadius="12"
                        Orientation="Horizontal"
                        Spacing="2">
                        <ToggleButton
                            x:Name="SegAll"
                            Click="SegAll_Click"
                            Content="全部"
                            IsChecked="True"
                            Style="{StaticResource SegBtnStyle}" />
                        <ToggleButton
                            x:Name="SegToday"
                            Click="SegToday_Click"
                            Content="今日"
                            Style="{StaticResource SegBtnStyle}" />
                        <ToggleButton
                            x:Name="SegCalendar"
                            Click="SegCalendar_Click"
                            Content="日历"
                            Style="{StaticResource SegBtnStyle}" />
                    </StackPanel>
                    <StackPanel
                        x:Name="ActionsPanel"
                        Grid.Column="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            x:Name="SettingsButton"
                            Click="SettingsButton_Click"
                            Style="{StaticResource IconBtnStyle}"
                            ToolTipService.ToolTip="设置">
                            <FontIcon FontSize="15" Glyph="&#xE713;" />
                        </Button>
                        <Border
                            Width="1"
                            Height="18"
                            Margin="4,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource GlassBorderBrush}" />
                        <!--  缩小为气泡：隐藏主窗口并在桌面留一个悬浮气泡  -->
                        <Button
                            x:Name="BubbleButton"
                            Click="BubbleButton_Click"
                            Style="{StaticResource IconBtnStyle}"
                            ToolTipService.ToolTip="缩小为气泡">
                            <FontIcon FontSize="14" Glyph="&#xE8A5;" />
                        </Button>
                        <Border
                            Width="1"
                            Height="18"
                            Margin="4,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource GlassBorderBrush}" />
                        <!--  仅保留关闭按钮  -->
                        <Button
                            x:Name="CloseButton"
                            Click="CloseButton_Click"
                            Style="{StaticResource IconBtnStyle}"
                            ToolTipService.ToolTip="关闭">
                            <FontIcon FontSize="13" Glyph="&#xE8BB;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!--  ═══ 卡片 2：内容区 ═══  -->
        <Border
            Grid.Row="1"
            Padding="14"
            Style="{StaticResource GlassCardStyle}">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  快速添加：窄窗口自动换行为两行（UpdateQuickAddLayout）  -->
                <Grid
                    x:Name="QuickAddRow"
                    Grid.Row="0"
                    ColumnSpacing="8"
                    RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="QuickAddCol0" Width="*" />
                        <ColumnDefinition x:Name="QuickAddCol1" Width="110" />
                        <ColumnDefinition x:Name="QuickAddCol2" Width="120" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <AutoSuggestBox
                        x:Name="QuickTitle"
                        Grid.Row="0"
                        Grid.Column="0"
                        MinHeight="38"
                        PlaceholderText="添加待办，回车确认…"
                        QuerySubmitted="QuickTitle_QuerySubmitted"
                        TextChanged="QuickTitle_TextChanged" />

                    <ComboBox
                        x:Name="QuickPriority"
                        Grid.Row="0"
                        Grid.Column="1"
                        MinHeight="38"
                        VerticalAlignment="Stretch"
                        SelectedIndex="1">
                        <ComboBoxItem Content="低" Tag="Low" />
                        <ComboBoxItem Content="中" Tag="Medium" />
                        <ComboBoxItem Content="高" Tag="High" />
                        <ComboBoxItem Content="紧急" Tag="Critical" />
                    </ComboBox>

                    <CalendarDatePicker
                        x:Name="QuickDate"
                        Grid.Row="0"
                        Grid.Column="2"
                        MinHeight="38"
                        PlaceholderText="计划日 可选" />

                    <Button
                        x:Name="QuickAddButton"
                        Grid.Row="0"
                        Grid.Column="3"
                        MinHeight="38"
                        Padding="16,0"
                        Background="{StaticResource AccentBrush}"
                        Click="QuickAddButton_Click"
                        Content="添加"
                        CornerRadius="10" />
                </Grid>

                <!--  主内容  -->
                <Grid Grid.Row="1">
                    <!--  全部 / 今日  -->
                    <Grid x:Name="ListPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  列表头  -->
                        <Grid
                            Grid.Row="0"
                            Margin="2,0,2,10"
                            ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                x:Name="ListTitle"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="全部待办" />

                            <Border
                                Grid.Column="1"
                                Padding="8,2"
                                VerticalAlignment="Center"
                                Background="#12FFFFFF"
                                CornerRadius="999">
                                <TextBlock
                                    x:Name="ListCount"
                                    FontSize="11"
                                    Foreground="{ThemeResource SubtleTextBrush}"
                                    Text="0" />
                            </Border>

                            <AutoSuggestBox
                                x:Name="SearchBox"
                                Grid.Column="3"
                                Width="180"
                                MinHeight="30"
                                PlaceholderText="搜索标题 / 备注"
                                TextChanged="SearchBox_TextChanged" />
                        </Grid>

                        <!--  列表  -->
                        <ListView
                            x:Name="MainListView"
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            AllowDrop="True"
                            CanReorderItems="True"
                            DragItemsCompleted="MainListView_DragItemsCompleted"
                            IsItemClickEnabled="False"
                            ItemsSource="{x:Bind ViewModel.GroupsView.View, Mode=OneWay}"
                            ReorderMode="Enabled"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.HorizontalScrollMode="Disabled"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate x:DataType="vm:StatusGroup">
                                            <Grid
                                                Padding="2,10,2,4"
                                                Background="Transparent"
                                                Tapped="GroupHeader_Tapped">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource SubtleTextBrush}"
                                                        Text="{x:Bind ChevronGlyph, Mode=OneWay}" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource SubtleTextBrush}"
                                                        Text="{x:Bind HeaderText, Mode=OneTime}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:TodoItemVm">
                                    <Grid
                                        MinHeight="48"
                                        Padding="0,6"
                                        ColumnSpacing="8"
                                        Tapped="Item_Tapped">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Command="{x:Bind OpenEditorCommand}" Text="编辑" />
                                                <MenuFlyoutItem Command="{x:Bind RemoveCommand}" Text="删除" />
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>

                                        <!--  左侧状态符号 ○ ● ✓  -->
                                        <Grid
                                            Grid.Column="0"
                                            Height="36"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            PointerEntered="StatusChip_PointerEntered"
                                            PointerExited="StatusChip_PointerExited">
                                            <Button
                                                Padding="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{x:Bind ToggleStatusCommand}"
                                                ToolTipService.ToolTip="点击循环状态；悬停可选择"
                                                Visibility="{x:Bind StatusChipVis, Mode=OneWay}">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="15"
                                                    Foreground="{x:Bind StatusDotBrush, Mode=OneWay}"
                                                    Text="{x:Bind StatusGlyph, Mode=OneWay}" />
                                            </Button>
                                        </Grid>

                                        <!--  重要程度色条  -->
                                        <Border
                                            Grid.Column="1"
                                            Width="4"
                                            Height="32"
                                            VerticalAlignment="Center"
                                            Background="{x:Bind PriorityBrush, Mode=OneWay}"
                                            CornerRadius="2" />

                                        <!--  标题 / 备注  -->
                                        <Grid
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            RowSpacing="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <TextBlock
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Foreground="{x:Bind TitleBrush, Mode=OneWay}"
                                                    MaxLines="2"
                                                    Text="{x:Bind Title, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />
                                                <Border
                                                    Height="1"
                                                    Margin="0,1"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Background="{x:Bind TitleBrush, Mode=OneWay}"
                                                    Visibility="{x:Bind StrikeVisibility, Mode=OneWay}" />
                                            </Grid>

                                            <TextBlock
                                                Grid.Row="1"
                                                HorizontalAlignment="Stretch"
                                                FontSize="11"
                                                Foreground="{ThemeResource SubtleTextBrush}"
                                                MaxLines="2"
                                                Text="{x:Bind Notes, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind NotesVisibility, Mode=OneWay}" />
                                        </Grid>

                                        <!--  状态文字  -->
                                        <Button
                                            Grid.Column="3"
                                            Padding="0"
                                            HorizontalContentAlignment="Right"
                                            VerticalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{x:Bind ToggleStatusCommand}"
                                            ToolTipService.ToolTip="点击循环：未开始 → 进行中 → 已完成">
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{ThemeResource SubtleTextBrush}"
                                                Text="{x:Bind StatusDisplay, Mode=OneWay}"
                                                TextWrapping="NoWrap" />
                                        </Button>

                                        <!--  计划日：定宽  -->
                                        <TextBlock
                                            Grid.Column="4"
                                            Margin="4,0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{x:Bind PlannedDateBrush, Mode=OneWay}"
                                            Text="{x:Bind PlannedDateDisplay, Mode=OneWay}"
                                            TextAlignment="Right"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />


                                        <!--  展开三态：Canvas 纯悬浮，不使用椭圆边框  -->
                                        <Canvas
                                            Grid.ColumnSpan="5"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Canvas.ZIndex="50"
                                            PointerEntered="StatusChip_PointerEntered"
                                            PointerExited="StatusChip_PointerExited"
                                            Visibility="{x:Bind StatusOptionsVis, Mode=OneWay}">
                                            <StackPanel
                                                Canvas.Left="0"
                                                Canvas.Top="4"
                                                Padding="4,2"
                                                Background="{ThemeResource SolidCardBrush}"
                                                CornerRadius="10"
                                                Orientation="Horizontal"
                                                Spacing="4">
                                                <Button
                                                    Width="28"
                                                    Height="28"
                                                    Padding="0"
                                                    Background="{ThemeResource SolidChipBrush}"
                                                    BorderThickness="0"
                                                    Command="{x:Bind SetNotStartedCommand}"
                                                    CornerRadius="8"
                                                    ToolTipService.ToolTip="未开始">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="15"
                                                        Foreground="{x:Bind NotStartedDotBrush, Mode=OneWay}"
                                                        Text="○" />
                                                </Button>
                                                <Button
                                                    Width="28"
                                                    Height="28"
                                                    Padding="0"
                                                    Background="{ThemeResource SolidChipBrush}"
                                                    BorderThickness="0"
                                                    Command="{x:Bind SetInProgressCommand}"
                                                    CornerRadius="8"
                                                    ToolTipService.ToolTip="进行中">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="15"
                                                        Foreground="{x:Bind InProgressDotBrush, Mode=OneWay}"
                                                        Text="●" />
                                                </Button>
                                                <Button
                                                    Width="28"
                                                    Height="28"
                                                    Padding="0"
                                                    Background="{ThemeResource SolidChipBrush}"
                                                    BorderThickness="0"
                                                    Command="{x:Bind SetCompletedCommand}"
                                                    CornerRadius="8"
                                                    ToolTipService.ToolTip="已完成">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="15"
                                                        Foreground="{x:Bind CompletedDotBrush, Mode=OneWay}"
                                                        Text="✓" />
                                                </Button>
                                            </StackPanel>
                                        </Canvas>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!--  空态  -->
                        <StackPanel
                            x:Name="EmptyPanel"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Visibility="Collapsed">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="28"
                                Foreground="{ThemeResource SubtleTextBrush}"
                                Opacity="0.5"
                                Text="○" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource SubtleTextBrush}"
                                Text="暂无待办 · 在上方添加" />
                        </StackPanel>
                    </Grid>

                    <!--  日历：窄窗口时上下堆叠（UpdateCalendarLayout）  -->
                    <Grid
                        x:Name="CalendarPanel"
                        ColumnSpacing="12"
                        RowSpacing="12"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="CalendarCol1" Width="240" />
                        </Grid.ColumnDefinitions>

                        <!--  月历  -->
                        <Border
                            x:Name="MonthCard"
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="12"
                            Background="#0AFFFFFF"
                            BorderBrush="{StaticResource GlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Grid.Column="0"
                                        Width="28"
                                        Height="28"
                                        Click="PrevMonth_Click"
                                        Content="‹"
                                        Style="{StaticResource IconBtnStyle}" />
                                    <TextBlock
                                        x:Name="MonthTitle"
                                        Grid.Column="1"
                                        MinWidth="88"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="2026年1月"
                                        TextAlignment="Center" />
                                    <Button
                                        Grid.Column="2"
                                        Width="28"
                                        Height="28"
                                        Click="NextMonth_Click"
                                        Content="›"
                                        Style="{StaticResource IconBtnStyle}" />
                                    <Button
                                        Grid.Column="4"
                                        Width="Auto"
                                        Padding="10,0"
                                        Click="GoToday_Click"
                                        Content="今天"
                                        Style="{StaticResource IconBtnStyle}" />
                                </Grid>

                                <!--  星期头  -->
                                <Grid Grid.Row="1" ColumnSpacing="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{ThemeResource SubtleTextBrush}"
                                        Text="一" />
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{ThemeResource SubtleTextBrush}"
                                        Text="二" />
                                    <TextBlock
                                        Grid.Column="2"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{ThemeResource SubtleTextBrush}"
                                        Text="三" />
                                    <TextBlock
                                        Grid.Column="3"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{ThemeResource SubtleTextBrush}"
                                        Text="四" />
                                    <TextBlock
                                        Grid.Column="4"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{ThemeResource SubtleTextBrush}"
                                        Text="五" />
                                    <TextBlock
                                        Grid.Column="5"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{ThemeResource SubtleTextBrush}"
                                        Text="六" />
                                    <TextBlock
                                        Grid.Column="6"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{ThemeResource SubtleTextBrush}"
                                        Text="日" />
                                </Grid>

                                <Grid
                                    x:Name="CalendarGrid"
                                    Grid.Row="2"
                                    ColumnSpacing="5"
                                    RowSpacing="5">
                                    <!--  代码生成 6x7 日格  -->
                                </Grid>
                            </Grid>
                        </Border>

                        <!--  当日计划  -->
                        <Border
                            x:Name="DayPlanCard"
                            Grid.Row="0"
                            Grid.Column="1"
                            Padding="12"
                            Background="#0AFFFFFF"
                            BorderBrush="{StaticResource GlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    x:Name="DayTitle"
                                    Grid.Row="0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="1月15日" />
                                <TextBlock
                                    Grid.Row="1"
                                    FontSize="11"
                                    Foreground="{ThemeResource SubtleTextBrush}"
                                    Text="当日计划" />

                                <ListView
                                    x:Name="DayList"
                                    Grid.Row="2"
                                    ItemsSource="{x:Bind ViewModel.DayGroupsView.View, Mode=OneWay}"
                                    ScrollViewer.HorizontalScrollMode="Disabled"
                                    SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate x:DataType="vm:StatusGroup">
                                                    <Grid
                                                        Padding="2,10,2,4"
                                                        Background="Transparent"
                                                        Tapped="GroupHeader_Tapped">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontSize="11"
                                                                Foreground="{ThemeResource SubtleTextBrush}"
                                                                Text="{x:Bind ChevronGlyph, Mode=OneWay}" />
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Foreground="{ThemeResource SubtleTextBrush}"
                                                                Text="{x:Bind HeaderText, Mode=OneTime}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ListView.GroupStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TodoItemVm">
                                            <Grid
                                                Padding="2,8"
                                                ColumnSpacing="8"
                                                Tapped="Item_Tapped">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="52" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Width="4"
                                                    Height="18"
                                                    VerticalAlignment="Center"
                                                    Background="{x:Bind PriorityBrush, Mode=OneWay}"
                                                    CornerRadius="2" />
                                                <Grid Grid.Column="1">
                                                    <TextBlock
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{x:Bind TitleBrush, Mode=OneWay}"
                                                        Text="{x:Bind Title, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />
                                                    <Border
                                                        Height="1"
                                                        Margin="0,1"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Center"
                                                        Background="{x:Bind TitleBrush, Mode=OneWay}"
                                                        Visibility="{x:Bind StrikeVisibility, Mode=OneWay}" />
                                                </Grid>
                                                <Button
                                                    Grid.Column="2"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{x:Bind ToggleStatusCommand}">
                                                    <TextBlock
                                                        HorizontalAlignment="Stretch"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource SubtleTextBrush}"
                                                        Text="{x:Bind StatusDisplay, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <Button
                                    Grid.Row="3"
                                    MinHeight="34"
                                    HorizontalAlignment="Stretch"
                                    Click="AddToDay_Click"
                                    Content="添加到该日" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!--  详情页  -->
                    <Grid
                        x:Name="DetailPanel"
                        RowSpacing="14"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  头部：返回 + 操作  -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="DetailBackButton"
                                Padding="12,7"
                                Click="DetailBack_Click"
                                CornerRadius="9">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE72B;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="返回" />
                                </StackPanel>
                            </Button>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="待办详情" />

                            <Button
                                Grid.Column="2"
                                Padding="12,7"
                                Click="DetailDelete_Click"
                                Content="删除"
                                CornerRadius="9"
                                Foreground="{StaticResource PrioCritBrush}" />
                        </Grid>

                        <!--  字段  -->
                        <ScrollViewer
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel
                                MinWidth="320"
                                MaxWidth="560"
                                HorizontalAlignment="Left"
                                Spacing="14">
                                <TextBox
                                    x:Name="DetailTitleBox"
                                    Header="标题"
                                    MaxLength="200"
                                    PlaceholderText="必填" />

                                <TextBox
                                    x:Name="DetailNotesBox"
                                    Height="120"
                                    AcceptsReturn="True"
                                    Header="备注"
                                    MaxLength="2000"
                                    PlaceholderText="可选"
                                    TextWrapping="Wrap" />

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox
                                        x:Name="DetailStatusCombo"
                                        HorizontalAlignment="Stretch"
                                        Header="状态">
                                        <ComboBoxItem Content="未开始" Tag="NotStarted" />
                                        <ComboBoxItem Content="进行中" Tag="InProgress" />
                                        <ComboBoxItem Content="已完成" Tag="Completed" />
                                    </ComboBox>

                                    <ComboBox
                                        x:Name="DetailPriorityCombo"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        Header="优先级">
                                        <ComboBoxItem Content="低" Tag="Low" />
                                        <ComboBoxItem Content="中" Tag="Medium" />
                                        <ComboBoxItem Content="高" Tag="High" />
                                        <ComboBoxItem Content="紧急" Tag="Critical" />
                                    </ComboBox>
                                </Grid>

                                <CalendarDatePicker
                                    x:Name="DetailDatePick"
                                    HorizontalAlignment="Stretch"
                                    Header="计划日"
                                    PlaceholderText="未排期" />

                                <Button
                                    HorizontalAlignment="Left"
                                    Click="DetailClearDate_Click"
                                    Content="清除计划日" />

                                <TextBlock
                                    x:Name="DetailMetaText"
                                    FontSize="11"
                                    Foreground="{ThemeResource SubtleTextBrush}"
                                    Text="" />
                            </StackPanel>
                        </ScrollViewer>

                        <!--  底部：保存  -->
                        <Button
                            Grid.Row="2"
                            MinHeight="38"
                            HorizontalAlignment="Stretch"
                            Background="{StaticResource AccentBrush}"
                            Click="DetailSave_Click"
                            Content="保存更改"
                            CornerRadius="10" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!--  撤销 Snackbar  -->
        <Border
            x:Name="Snack"
            Grid.Row="1"
            Margin="0,0,0,18"
            Padding="14,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{ThemeResource DialogCardBrush}"
            BorderBrush="{ThemeResource CardStrokeBrush}"
            BorderThickness="1"
            Canvas.ZIndex="20"
            CornerRadius="12"
            Visibility="{x:Bind ViewModel.SnackVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock
                    x:Name="SnackText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource PrimaryTextBrush}"
                    Text="{x:Bind ViewModel.SnackText, Mode=OneWay}" />
                <Button
                    Padding="10,5"
                    Background="#334C6FFF"
                    Command="{x:Bind ViewModel.UndoDeleteCommand, Mode=OneWay}"
                    Content="撤销"
                    CornerRadius="8"
                    Foreground="{ThemeResource AccentBrush}" />
            </StackPanel>
        </Border>

        <!--  设置：全屏遮罩 + 居中弹窗  -->
        <Grid
            x:Name="SettingsOverlay"
            Grid.Row="0"
            Grid.RowSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Canvas.ZIndex="40"
            Visibility="Collapsed">
            <Border Background="{ThemeResource ScrimBrush}" Tapped="SettingsScrim_Tapped" />

            <Border
                x:Name="SettingsCard"
                MinWidth="380"
                MaxWidth="440"
                Padding="24,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource DialogCardBrush}"
                BorderBrush="{ThemeResource CardStrokeBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Tapped="SettingsCard_Tapped">
                <StackPanel MinWidth="340" Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource PrimaryTextBrush}"
                            Text="设置" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource SubtleTextBrush}"
                            Text="窗口与列表偏好" />
                    </StackPanel>

                    <StackPanel Spacing="0">
                        <Grid Padding="0,10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{ThemeResource PrimaryTextBrush}"
                                    Text="窗口置顶" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource SubtleTextBrush}"
                                    Text="让待办浮在其它窗口上"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="TopMostSwitch"
                                Grid.Column="1"
                                MinWidth="0"
                                VerticalAlignment="Center"
                                IsOn="True"
                                OffContent=""
                                OnContent=""
                                Toggled="TopMostSwitch_Toggled" />
                        </Grid>

                        <Grid Padding="0,10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{ThemeResource PrimaryTextBrush}"
                                    Text="隐藏已完成" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource SubtleTextBrush}"
                                    Text="列表中不显示已完成项"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="HideCompletedSwitch"
                                Grid.Column="1"
                                MinWidth="0"
                                VerticalAlignment="Center"
                                OffContent=""
                                OnContent=""
                                Toggled="HideCompletedSwitch_Toggled" />
                        </Grid>

                        <Grid Padding="0,10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{ThemeResource PrimaryTextBrush}"
                                    Text="开机自启" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource SubtleTextBrush}"
                                    Text="登录 Windows 后自动启动"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="StartupSwitch"
                                Grid.Column="1"
                                MinWidth="0"
                                VerticalAlignment="Center"
                                OffContent=""
                                OnContent=""
                                Toggled="StartupSwitch_Toggled" />
                        </Grid>
                    </StackPanel>

                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource SubtleTextBrush}"
                        Text="主题 · 跟随系统 · Mica 玻璃" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
