<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TodoList.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!-- 深色（Default） -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="GlassCardBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="GlassBorderBrush" Color="#22FFFFFF" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#B3EEF2F8" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F2F5FA" />
                    <SolidColorBrush x:Key="ScrimBrush" Color="#99000000" />
                    <SolidColorBrush x:Key="DialogCardBrush" Color="#F01C2438" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#22FFFFFF" />
                    <SolidColorBrush x:Key="SolidCardBrush" Color="#FF1C2438" />
                    <SolidColorBrush x:Key="SolidChipBrush" Color="#FF2A3348" />
                </ResourceDictionary>
                <!-- 浅色 -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="GlassCardBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="GlassBorderBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#A61B1B1F" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1B1B1F" />
                    <SolidColorBrush x:Key="ScrimBrush" Color="#66000000" />
                    <SolidColorBrush x:Key="DialogCardBrush" Color="#F5FFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="SolidCardBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SolidChipBrush" Color="#FFEEF0F4" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 优先级四色（品牌色，双主题可读） -->
            <SolidColorBrush x:Key="PrioLowBrush" Color="#5B6575" />
            <SolidColorBrush x:Key="PrioMedBrush" Color="#B86E00" />
            <SolidColorBrush x:Key="PrioHighBrush" Color="#C24A1F" />
            <SolidColorBrush x:Key="PrioCritBrush" Color="#C42B1C" />

            <!-- 状态三色 -->
            <SolidColorBrush x:Key="StatusTodoBrush" Color="#5B6575" />
            <SolidColorBrush x:Key="StatusRunBrush" Color="#2F5FD0" />
            <SolidColorBrush x:Key="StatusDoneBrush" Color="#0F7B4F" />
            <SolidColorBrush x:Key="AccentBrush" Color="#4C6FFF" />

            <Style x:Key="GlassCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource GlassCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
            </Style>

            <Style x:Key="IconBtnStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SegBtnStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinWidth" Value="64" />
            </Style>

            <Style x:Key="PillBtnStyle" TargetType="Button">
                <Setter Property="Background" Value="#14A8B3C4" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#38A8B3C4" />
                <Setter Property="CornerRadius" Value="999" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinWidth" Value="68" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
