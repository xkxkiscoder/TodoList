<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="TodoList.Views.EditTodoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:TodoList.Models"
    Title="编辑待办"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    CloseButtonClick="OnCloseButtonClick">

    <StackPanel Spacing="12" MinWidth="360">
        <TextBox x:Name="TitleBox"
                 Header="标题"
                 PlaceholderText="必填"
                 MaxLength="200" />

        <TextBox x:Name="NotesBox"
                 Header="备注"
                 PlaceholderText="可选"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Height="88"
                 MaxLength="2000" />

        <ComboBox x:Name="StatusCombo"
                  Header="状态"
                  HorizontalAlignment="Stretch">
            <ComboBoxItem Content="未开始" Tag="NotStarted" />
            <ComboBoxItem Content="进行中" Tag="InProgress" />
            <ComboBoxItem Content="已完成" Tag="Completed" />
        </ComboBox>

        <ComboBox x:Name="PriorityCombo"
                  Header="优先级"
                  HorizontalAlignment="Stretch">
            <ComboBoxItem Content="低" Tag="Low" />
            <ComboBoxItem Content="中" Tag="Medium" />
            <ComboBoxItem Content="高" Tag="High" />
            <ComboBoxItem Content="紧急" Tag="Critical" />
        </ComboBox>

        <CalendarDatePicker x:Name="DatePick"
                            Header="计划日"
                            HorizontalAlignment="Stretch"
                            PlaceholderText="未排期" />

        <Button x:Name="ClearDateButton"
                Content="清除计划日"
                HorizontalAlignment="Left"
                Click="ClearDate_Click" />
    </StackPanel>
</ContentDialog>
